<UserControl
    x:Class="OpenSysKit.UI.Views.Pages.ProcessesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:OpenSysKit.UI.ViewModels"
    xmlns:models="using:OpenSysKit.UI.Models"
    xmlns:conv="using:OpenSysKit.UI.Converters"
    x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <conv:BooleanToGlyphChevronConverter x:Key="BooleanToGlyphChevronConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <Border Classes="panel" Padding="16,14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="任务管理器" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProcessesSummary}" FontSize="12" Classes="muted" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Classes="chrome"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    Watermark="搜索进程名、PID 或父 PID..."
                    MinWidth="240"
                    FontSize="12"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="0" Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource AppHeaderBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,12">
                    <Grid ColumnDefinitions="*,95,130,110,80,95">
                        <TextBlock Text="名称 / 分组" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="PID" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="2" Text="关系" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="3" Text="内存" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="4" Text="线程" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="5" Text="父 PID" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                    </Grid>
                </Border>

                <DataGrid
                    Grid.Row="1"
                    x:Name="ProcessGrid"
                    ItemsSource="{Binding ProcessRows}"
                    SelectedItem="{Binding SelectedProcessRow, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0">
                    <DataGrid.ContextMenu>
                        <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                            <MenuItem Header="普通结束任务" Command="{Binding TaskKillProcessCommand}" />
                            <MenuItem Header="内核结束" Command="{Binding KillProcessCommand}" />
                            <MenuItem Header="结束进程树" Command="{Binding KillProcessTreeCommand}" />
                            <Separator />
                            <MenuItem Header="冻结" Command="{Binding FreezeProcessCommand}" />
                            <MenuItem Header="解冻" Command="{Binding UnfreezeProcessCommand}" />
                            <Separator />
                            <MenuItem Header="进程保护 (PPL)">
                                <MenuItem Header="无保护" Command="{Binding SetProtectLevelCommand}" CommandParameter="0" />
                                <Separator />
                                <MenuItem Header="Authenticode-Light" Command="{Binding SetProtectLevelCommand}" CommandParameter="17" />
                                <MenuItem Header="Antimalware-Light (推荐)" Command="{Binding SetProtectLevelCommand}" CommandParameter="49" />
                                <MenuItem Header="LSA-Light" Command="{Binding SetProtectLevelCommand}" CommandParameter="65" />
                                <MenuItem Header="Windows-Light" Command="{Binding SetProtectLevelCommand}" CommandParameter="81" />
                                <MenuItem Header="WinTcb-Light (最高)" Command="{Binding SetProtectLevelCommand}" CommandParameter="97" />
                            </MenuItem>
                            <MenuItem Header="取消保护" Command="{Binding UnprotectProcessCommand}" />
                            <Separator />
                            <MenuItem Header="隐藏进程" Command="{Binding HideProcessCommand}" />
                            <MenuItem Header="取消隐藏" Command="{Binding UnhideProcessCommand}" />
                            <Separator />
                            <MenuItem Header="查看模块" Command="{Binding ViewModulesCommand}" />
                            <MenuItem Header="查看线程" Command="{Binding ViewThreadsCommand}" />
                            <MenuItem Header="查看句柄" Command="{Binding ViewHandlesCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="名称" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ProcessListRow">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Button
                                            Classes="icon"
                                            Command="{Binding DataContext.ToggleProcessGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding RootProcessId}"
                                            IsVisible="{Binding IsRootProcess}"
                                            Content="{Binding IsGroupExpanded, Converter={StaticResource BooleanToGlyphChevronConverter}}"
                                            VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ImageName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="rowBadge" Padding="8,2">
                                                    <TextBlock Text="{Binding RelationLabel}" Classes="caption" />
                                                </Border>
                                                <TextBlock Text="{Binding RootProcessName}" Classes="caption" IsVisible="{Binding IsRootProcess, Converter={StaticResource InverseBooleanConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="95" />
                        <DataGridTextColumn Header="关系" Binding="{Binding RelationLabel}" Width="130" />
                        <DataGridTextColumn Header="内存" Binding="{Binding WorkingSetDisplay}" Width="110" />
                        <DataGridTextColumn Header="线程" Binding="{Binding ThreadCount}" Width="80" />
                        <DataGridTextColumn Header="父 PID" Binding="{Binding ParentProcessId}" Width="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="panel" Padding="0" Margin="0,0,0,12" IsVisible="{Binding ShowDetailPanel}">
            <Grid ColumnDefinitions="1.1*,0.9*">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderStrongBrush}">
                        <TextBlock Text="模块" FontSize="12" FontWeight="SemiBold" Classes="muted" />
                    </Border>
                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding ProcessModules}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        CanUserResizeColumns="True"
                        MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模块名" Binding="{Binding ModuleName}" Width="*" />
                            <DataGridTextColumn Header="基地址" Binding="{Binding BaseAddressHex}" Width="160" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Border Padding="14,10" BorderThickness="1,0,0,1" BorderBrush="{DynamicResource AppBorderStrongBrush}">
                        <TextBlock Text="线程" FontSize="12" FontWeight="SemiBold" Classes="muted" />
                    </Border>
                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding ProcessThreads}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        CanUserResizeColumns="True"
                        MaxHeight="220">
                        <DataGrid.ContextMenu>
                            <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                                <MenuItem Header="挂起线程" Command="{Binding SuspendThreadCommand}" CommandParameter="{Binding SelectedItem.ThreadId, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <MenuItem Header="恢复线程" Command="{Binding ResumeThreadCommand}" CommandParameter="{Binding SelectedItem.ThreadId, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="线程 ID" Binding="{Binding ThreadId}" Width="90" />
                            <DataGridTextColumn Header="优先级" Binding="{Binding BasePriority}" Width="80" />
                            <DataGridTextColumn Header="起始地址" Binding="{Binding StartAddressHex}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="panel" Padding="0" IsVisible="{Binding ShowHandlesPanel}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <Border Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderStrongBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="句柄类型统计" FontSize="12" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Text="{Binding HandlesSummary}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <DataGrid
                    Grid.Row="1"
                    ItemsSource="{Binding HandleTypes}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型索引" Binding="{Binding TypeIndex}" Width="120" />
                        <DataGridTextColumn Header="类型名称" Binding="{Binding TypeName}" Width="*" />
                        <DataGridTextColumn Header="句柄数量" Binding="{Binding Count}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Padding="14,10" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource AppBorderStrongBrush}" IsVisible="{Binding ShowHandleDetails}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="句柄详情" FontSize="12" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Text="{Binding HandleDetailsSummary}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <DataGrid
                    Grid.Row="3"
                    ItemsSource="{Binding HandleDetails}"
                    SelectedItem="{Binding SelectedHandle, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    SelectionMode="Single"
                    MaxHeight="300"
                    IsVisible="{Binding ShowHandleDetails}">
                    <DataGrid.ContextMenu>
                        <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                            <MenuItem Header="关闭句柄" Command="{Binding CloseSelectedHandleCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="句柄" Binding="{Binding HandleHex}" Width="100" />
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="120" />
                        <DataGridTextColumn Header="名称" Binding="{Binding ObjectName}" Width="*" />
                        <DataGridTextColumn Header="权限" Binding="{Binding GrantedAccessHex}" Width="120" />
                        <DataGridTextColumn Header="对象地址" Binding="{Binding ObjectAddressHex}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
