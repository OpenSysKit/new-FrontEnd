<views:ViewModelPage
    x:Class="OpenSysKit.UI.Views.Pages.KernelModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpenSysKit.UI.Models"
    xmlns:views="using:OpenSysKit.UI.Views.Pages"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="20" Spacing="16">
            <Border Style="{StaticResource CardBorderStyle}">
                <TextBlock Text="{Binding KernelModulesSummary}" />
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="220,180,120,*" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="模块名" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="基地址" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionHeaderTextStyle}" Text="大小" />
                        <TextBlock Grid.Column="3" Style="{StaticResource SectionHeaderTextStyle}" Text="路径" />
                    </Grid>
                    <ListView ItemsSource="{Binding KernelModules}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:KernelModule">
                                <Grid ColumnDefinitions="220,180,120,*" Padding="0,6">
                                    <TextBlock Text="{x:Bind ModuleName}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BaseAddressHex}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Path}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</views:ViewModelPage>
