<UserControl
    x:Class="OpenSysKit.UI.Views.Pages.KernelModulesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenSysKit.UI.ViewModels"
    x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <Border Classes="panel" Padding="16,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="内核模块" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding KernelModulesSummary}" FontSize="12" Classes="muted" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Classes="chrome"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    Watermark="搜索模块名或路径..."
                    MinWidth="220"
                    FontSize="12"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="0" Margin="0,12,0,0">
            <DataGrid
                ItemsSource="{Binding KernelModules}"
                SelectedItem="{Binding SelectedKernelModule, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0">
                <DataGrid.ContextMenu>
                    <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                        <MenuItem Header="卸载驱动" Command="{Binding UnloadDriverCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模块名" Binding="{Binding ModuleName}" Width="200" />
                    <DataGridTextColumn Header="基地址" Binding="{Binding BaseAddressHex}" Width="180" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="100" />
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
