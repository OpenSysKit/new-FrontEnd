<Page
    x:Class="OpenSysKit.UI.Views.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="20" Spacing="16">
            <Border Style="{StaticResource CardBorderStyle}">
                <TextBlock Text="{Binding ServicesSummary}" />
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="220,2*,120,120" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="服务名" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="显示名" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionHeaderTextStyle}" Text="状态" />
                        <TextBlock Grid.Column="3" Style="{StaticResource SectionHeaderTextStyle}" Text="启动类型" />
                    </Grid>
                    <ListView ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="220,2*,120,120" Padding="0,6">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" />
                                    <TextBlock Grid.Column="3" Text="{Binding StartType}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding StartServiceCommand}" Content="启动服务" />
                <Button Command="{Binding StopServiceCommand}" Content="停止服务" Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
