<UserControl
    x:Class="OpenSysKit.UI.Views.Pages.ServicesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:OpenSysKit.UI.ViewModels"
    x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <suki:GlassCard>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="服务管理" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ServicesSummary}" FontSize="13" Opacity="0.6" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    Watermark="搜索服务名或显示名..."
                    MinWidth="220"
                    FontSize="12"
                    VerticalAlignment="Center" />
            </Grid>
        </suki:GlassCard>

        <suki:GlassCard Grid.Row="1" Padding="0" Margin="0,12,0,0">
            <DataGrid
                ItemsSource="{Binding Services}"
                SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0">
                <DataGrid.ContextMenu>
                    <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                        <MenuItem Header="启动服务" Command="{Binding StartServiceCommand}" />
                        <MenuItem Header="停止服务" Command="{Binding StopServiceCommand}" />
                        <Separator />
                        <MenuItem Header="设为自动启动" Command="{Binding SetServiceStartTypeCommand}" CommandParameter="auto" />
                        <MenuItem Header="设为手动启动" Command="{Binding SetServiceStartTypeCommand}" CommandParameter="manual" />
                        <MenuItem Header="禁用" Command="{Binding SetServiceStartTypeCommand}" CommandParameter="disabled" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="服务名" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="120" />
                    <DataGridTextColumn Header="启动类型" Binding="{Binding StartType}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </suki:GlassCard>
    </Grid>
</UserControl>
