<UserControl
    x:Class="OpenSysKit.UI.Views.Pages.FilesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:OpenSysKit.UI.ViewModels"
    x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <!-- header -->
        <suki:GlassCard>
            <StackPanel Spacing="4">
                <TextBlock Text="文件浏览" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FilesSummary}" FontSize="13" Opacity="0.6" />
            </StackPanel>
        </suki:GlassCard>

        <!-- address bar -->
        <suki:GlassCard Grid.Row="1" Padding="12" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <Button
                    Classes="Basic"
                    Command="{Binding NavigateUpCommand}"
                    Content="↑"
                    FontSize="14"
                    Padding="10,5"
                    ToolTip.Tip="返回上级目录"
                    Margin="0,0,8,0" />
                <TextBox
                    Grid.Column="1"
                    Text="{Binding CurrentPath, Mode=TwoWay}"
                    Watermark="输入路径后按 Enter"
                    KeyDown="PathBox_OnKeyDown"
                    FontSize="13"
                    CornerRadius="6" />
            </Grid>
        </suki:GlassCard>

        <!-- file list -->
        <suki:GlassCard Grid.Row="2" Padding="0" Margin="0,12,0,0">
            <DataGrid
                x:Name="FilesGrid"
                ItemsSource="{Binding FileEntries}"
                SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0"
                DoubleTapped="FilesGrid_OnDoubleTapped">
                <DataGrid.ContextMenu>
                    <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                        <MenuItem Header="打开" Click="OpenMenuItem_OnClick" />
                        <MenuItem Header="复制路径" Click="CopyPathMenuItem_OnClick" />
                        <Separator />
                        <MenuItem Header="结束占用进程" Command="{Binding KillLockingProcessesCommand}" />
                        <MenuItem Header="内核删除" Command="{Binding DeleteFileCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类别" Binding="{Binding KindLabel}" Width="80" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="110" />
                    <DataGridTextColumn Header="修改时间" Binding="{Binding ModTime}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </suki:GlassCard>

        <!-- selected file info -->
        <suki:GlassCard Grid.Row="3" Margin="0,12,0,0" IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Spacing="2">
                    <TextBlock Text="选中项" FontSize="11" Opacity="0.5" />
                    <TextBlock Text="{Binding SelectedFileDisplay}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" Margin="16,0,0,0">
                    <TextBlock Text="类型" FontSize="11" Opacity="0.5" />
                    <TextBlock Text="{Binding SelectedFileKind}" FontSize="13" FontWeight="Medium" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" Margin="16,0,0,0">
                    <TextBlock Text="路径" FontSize="11" Opacity="0.5" />
                    <TextBlock Text="{Binding SelectedFilePath}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </suki:GlassCard>
    </Grid>
</UserControl>
