<UserControl
    x:Class="OpenSysKit.UI.Views.Pages.FilesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:OpenSysKit.UI.ViewModels"
    x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <Border Classes="panel" Padding="16,14" Margin="0,0,0,12">
            <StackPanel Spacing="4">
                <TextBlock Text="文件管理器" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FilesSummary}" FontSize="12" Classes="muted" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    Classes="chrome"
                    Command="{Binding NavigateUpCommand}"
                    Content="上一级"
                    FontSize="12"
                    ToolTip.Tip="返回上级目录" />
                <TextBox
                    Grid.Column="1"
                    Classes="chrome"
                    Margin="12,0,0,0"
                    Text="{Binding CurrentPath, Mode=TwoWay}"
                    Watermark="输入路径后按 Enter"
                    KeyDown="PathBox_OnKeyDown"
                    FontSize="12.5" />
                <Button
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Classes="chrome"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="{Binding CurrentPath}"
                    Content="转到"
                    FontSize="12" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="panel" Padding="0" Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource AppHeaderBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,12">
                    <Grid ColumnDefinitions="100,*,120,170">
                        <TextBlock Text="类型" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="名称" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="2" Text="大小" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Grid.Column="3" Text="修改时间" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                    </Grid>
                </Border>
                <DataGrid
                    Grid.Row="1"
                    x:Name="FilesGrid"
                    ItemsSource="{Binding FileEntries}"
                    SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    DoubleTapped="FilesGrid_OnDoubleTapped">
                    <DataGrid.ContextMenu>
                        <ContextMenu Placement="Pointer" WindowManagerAddShadowHint="False">
                            <MenuItem Header="打开" Click="OpenMenuItem_OnClick" />
                            <MenuItem Header="复制路径" Click="CopyPathMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="结束占用进程" Command="{Binding KillLockingProcessesCommand}" />
                            <MenuItem Header="内核删除" Command="{Binding DeleteFileCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类别" Binding="{Binding KindLabel}" Width="100" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="120" />
                        <DataGridTextColumn Header="修改时间" Binding="{Binding ModTime}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="panel" Padding="12,10">
            <StackPanel Spacing="3">
                <TextBlock Text="状态反馈" FontSize="10.5" Classes="muted" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
