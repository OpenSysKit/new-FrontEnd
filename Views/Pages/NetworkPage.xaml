<Page
    x:Class="OpenSysKit.UI.Views.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpenSysKit.UI.Models"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="20" Spacing="16">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Text="当前过滤" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding NetProtocol}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ConnectionsSummary}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="80,200,220,100,100,*" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="协议" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="本地地址" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionHeaderTextStyle}" Text="远端地址" />
                        <TextBlock Grid.Column="3" Style="{StaticResource SectionHeaderTextStyle}" Text="状态" />
                        <TextBlock Grid.Column="4" Style="{StaticResource SectionHeaderTextStyle}" Text="PID" />
                        <TextBlock Grid.Column="5" Style="{StaticResource SectionHeaderTextStyle}" Text="进程名" />
                    </Grid>
                    <ListView ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkConnection">
                                <Grid ColumnDefinitions="80,200,220,100,100,*" Padding="0,6">
                                    <TextBlock Text="{Binding Protocol}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LocalEndpoint}" />
                                    <TextBlock Grid.Column="2" Text="{Binding RemoteEndpoint}" />
                                    <TextBlock Grid.Column="3" Text="{Binding State}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ProcessId}" />
                                    <TextBlock Grid.Column="5" Text="{Binding ProcessName}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
