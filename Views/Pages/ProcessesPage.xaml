<Page
    x:Class="OpenSysKit.UI.Views.Pages.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="20" Spacing="16">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="概览" />
                    <TextBlock Text="{Binding ProcessesSummary}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="80,2*,120,90,90" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="PID" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="进程名" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionHeaderTextStyle}" Text="内存" />
                        <TextBlock Grid.Column="3" Style="{StaticResource SectionHeaderTextStyle}" Text="线程数" />
                        <TextBlock Grid.Column="4" Style="{StaticResource SectionHeaderTextStyle}" Text="父 PID" />
                    </Grid>
                    <ListView ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,2*,120,90,90" Padding="0,6">
                                    <TextBlock Text="{Binding ProcessId}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ImageName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding WorkingSetDisplay}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ThreadCount}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ParentProcessId}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding KillProcessCommand}" Content="结束任务" Style="{StaticResource DangerButtonStyle}" />
                <Button Command="{Binding ProtectProcessCommand}" Content="保护进程" />
                <Button Command="{Binding FreezeProcessCommand}" Content="冻结进程" />
                <Button Command="{Binding ViewModulesCommand}" Content="加载模块" />
                <Button Command="{Binding ViewThreadsCommand}" Content="加载线程" />
            </StackPanel>

            <Border
                Style="{StaticResource CardBorderStyle}"
                Visibility="{Binding ShowDetailPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="模块" />
                        <ListView ItemsSource="{Binding ProcessModules}">
                            <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,150,120" Padding="0,6">
                                        <TextBlock Text="{Binding ModuleName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding BaseAddressHex}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" />
                                </Grid>
                            </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="线程" />
                        <ListView ItemsSource="{Binding ProcessThreads}">
                            <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,120,160" Padding="0,6">
                                        <TextBlock Text="{Binding ThreadId}" />
                                        <TextBlock Grid.Column="1" Text="{Binding BasePriority}" />
                                        <TextBlock Grid.Column="2" Text="{Binding StartAddressHex}" />
                                </Grid>
                            </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
