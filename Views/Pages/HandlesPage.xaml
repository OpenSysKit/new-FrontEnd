<Page
    x:Class="OpenSysKit.UI.Views.Pages.HandlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="目标进程" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedProcessDisplay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="切页后默认自动加载" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="类型数" />
                    <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding HandleTypes.Count}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{Binding HandlesSummary}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="状态" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="句柄统计面板" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Button Command="{Binding LoadHandlesCommand}" Content="刷新句柄" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="2.2*,1*" ColumnSpacing="16">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="120,2*,140" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="类型索引" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHeaderTextStyle}" Text="类型名称" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionHeaderTextStyle}" Text="句柄数量" />
                    </Grid>

                    <ListView Grid.Row="1" ItemContainerStyle="{StaticResource DataListViewItemStyle}" ItemsSource="{Binding HandleTypes}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource ShellRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid ColumnDefinitions="120,2*,140">
                                        <TextBlock Style="{StaticResource DataValueTextStyle}" Text="{Binding TypeIndex}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DataValueTextStyle}" Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource DataValueTextStyle}" Text="{Binding Count}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="统计说明" />
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding HandlesSummary}" TextWrapping="WrapWholeWords" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
