<Window
    x:Class="OpenSysKit.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{StaticResource ShellBackgroundBrush}">
        <NavigationView
            x:Name="ShellNav"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="760"
            CompactPaneLength="52"
            ExpandedModeThresholdWidth="1180"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            PaneDisplayMode="Auto"
            SelectionChanged="ShellNav_OnSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,20,16,14" Spacing="4">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="OpenSysKit" />
                    <TextBlock Opacity="0.72" Text="Windows system console" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="进程" Tag="Processes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络" Tag="Network">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="服务" Tag="Services">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="文件" Tag="Files">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="内核模块" Tag="KernelModules">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="句柄" Tag="Handles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="启动项" Tag="Startup">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="审计日志" Tag="Audit">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="24,20,24,16"
                    Background="{StaticResource ShellPanelBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding CurrentPageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{Binding CurrentPageSubtitle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Button Grid.Column="1" Click="ExportButton_OnClick" Content="导出报告" VerticalAlignment="Center" />

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="260,220,*" ColumnSpacing="12">
                            <Border Style="{StaticResource MetricCardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="连接状态" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="自动刷新" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding AutoRefreshDisplay}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="当前目标" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CurrentSelectionDisplay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
