<Application
    x:Class="OpenSysKit.UI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI">
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://OpenSysKit.UI/Assets/tray-icon.png"
                      ToolTipText="OpenSysKit"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="打开" Click="TrayOpen_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Click="TrayExit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
    <Application.Resources>
        <SolidColorBrush x:Key="SystemControlTransparentBrush" Color="Transparent" />
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#1C2128" />
        <SolidColorBrush x:Key="AppSurfaceSoftBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#484F58" />
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="AppHeaderBrush" Color="#161B22" />
        <SolidColorBrush x:Key="NotificationInfoBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="NotificationSuccessBrush" Color="#3FB950" />
        <SolidColorBrush x:Key="NotificationWarningBrush" Color="#D29922" />
        <SolidColorBrush x:Key="NotificationErrorBrush" Color="#F85149" />
    </Application.Resources>
    <Application.Styles>
        <suki:SukiTheme ThemeColor="Blue" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector="Application">
            <Setter Property="TextElement.Foreground" Value="#EDF3FB" />
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.panel.raised">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="#243244" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="TextBox.chrome">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Popup > Border">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="#263244" />
            <Setter Property="VerticalGridLinesBrush" Value="#1E2836" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
            <Setter Property="Foreground" Value="#B0BED0" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="suki|GlassCard">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="TreeView">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Application.Styles>
</Application>
