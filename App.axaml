<Application
    x:Class="OpenSysKit.UI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI">
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://OpenSysKit.UI/Assets/tray-icon.png"
                      ToolTipText="OpenSysKit"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="打开" Click="TrayOpen_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Click="TrayExit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
    <Application.Resources>
        <SolidColorBrush x:Key="SystemControlTransparentBrush" Color="Transparent" />
    </Application.Resources>
    <Application.Styles>
        <suki:SukiTheme ThemeColor="Blue" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ContextMenu: fast fade-in instead of default sluggish animation -->
        <Style Selector="ContextMenu">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- MenuFlyoutPresenter (used by some SukiUI context menus) -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Popup: snappy open/close -->
        <Style Selector="Popup > Border">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- DataGrid row: lighter transitions for selection highlight -->
        <Style Selector="DataGridRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>

        <!-- GlassCard: reduce transition overhead -->
        <Style Selector="suki|GlassCard">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- TreeView: compact rows for process tree -->
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <!-- TreeViewItem row: selection highlight transition -->
        <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Application.Styles>
</Application>
