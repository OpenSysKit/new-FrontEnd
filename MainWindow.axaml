<suki:SukiWindow
    x:Class="OpenSysKit.UI.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:OpenSysKit.UI.ViewModels"
    xmlns:pages="using:OpenSysKit.UI.Views.Pages"
    x:DataType="vm:MainViewModel"
    Title="OpenSysKit"
    Width="1280"
    Height="800"
    BackgroundStyle="Bubble">

    <suki:SukiWindow.LogoContent>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="⚙" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="OpenSysKit" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,8,0">
            <Border
                Background="{DynamicResource SukiAccentColor}"
                Opacity="0.8"
                CornerRadius="4"
                Padding="7,2"
                IsVisible="{Binding IsConnected}">
                <TextBlock Text="{Binding OverallHealth}" FontSize="11" Foreground="White" FontWeight="Medium" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        </StackPanel>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <suki:SukiSideMenu x:Name="SideMenu" IsSearchEnabled="False">
        <suki:SukiSideMenu.FooterContent>
            <StackPanel Margin="14,4,14,14" Spacing="5">
                <Border Height="1" Background="{DynamicResource SukiBorderBrush}" Opacity="0.2" Margin="0,0,0,2" />
                <TextBlock Text="{Binding AutoRefreshDisplay}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentSelectionDisplay}" FontSize="10.5" Opacity="0.45" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </suki:SukiSideMenu.FooterContent>

        <suki:SukiSideMenu.Items>
            <suki:SukiSideMenuItem Header="进程" Tag="Processes">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:ProcessesPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Header="网络" Tag="Network">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M17,12C17,14.42 15.28,16.44 13,16.9V21H11V16.9C8.72,16.44 7,14.42 7,12C7,9.58 8.72,7.56 11,7.1V3H13V7.1C15.28,7.56 17,9.58 17,12M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:NetworkPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Header="服务" Tag="Services">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:ServicesPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Header="文件" Tag="Files">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:FilesPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Header="内核模块" Tag="KernelModules">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M6,2V8H6V8L10,12L6,16V16H6V22H12V16H12L16,12L12,8H12V2H6M8,4H10V7.5L12.5,10L15,7.5V4H17V8.5L14,11.5L17,14.5V20H15V16.5L12.5,14L10,16.5V20H8V14.5L11,11.5L8,8.5V4Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:KernelModulesPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Header="启动项" Tag="Startup">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:StartupPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>

            <suki:SukiSideMenuItem Header="审计日志" Tag="Audit">
                <suki:SukiSideMenuItem.Icon>
                    <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Width="18" Height="18" />
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <pages:AuditPage />
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>
        </suki:SukiSideMenu.Items>
    </suki:SukiSideMenu>
</suki:SukiWindow>
